{
  "name": "reto-playwright-prima",
  "version": "1.0.0",
  "description": "Pruebas E2E de Sauce Demo con Playwright + Cucumber (TypeScript) y Page Object Model",
  "private": true,
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:login": "cucumber-js --tags @login",
    "test:carrito": "cucumber-js --tags @carrito",
    "test:compra": "cucumber-js --tags @compra",
    "typecheck": "tsc --noEmit",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
